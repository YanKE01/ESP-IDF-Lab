CONFIG_IDF_TARGET="esp32p4"

# Same P4 revision setting as the other P4 examples in this repo.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000

# ── ESP-Hosted host ────────────────────────────────────────────────────
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# Board presets lock the pins, so use no preset.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

# SPI full duplex. Must match cp/sdkconfig.defaults (mode 3).
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_MODE=3
# Jumper wires: start at 10 MHz, raise step by step (max 40).
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=10

CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=8
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=5
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=7
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=6
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=10
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=11
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=4
