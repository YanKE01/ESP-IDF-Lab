# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v2 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

#Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# BT Configuration
CONFIG_BT_ENABLED=n
#CONFIG_BT_CONTROLLER_ONLY=y

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y

# ── p4_c5_spi_hosted ─────────────────────────────────────────────────
# SPI full duplex, mode 3 (must match the host).
CONFIG_EH_TRANSPORT_CP_SPI=y
CONFIG_EH_TRANSPORT_CP_SPI_MODE_3=y
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CLK=4
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MOSI=10
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MISO=5
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CS=9
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_HANDSHAKE=23
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_DATA_READY=24
# -1: the host resets the C5 through its EN pin.
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_RESET=-1
